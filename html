<head>
    <meta charset="UTF-8">
    <title>Каталог: Colizant</title>
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@500;600;700&family=Onest:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>

<div th:replace="~{fragments/layout :: header('catalog')}"></div>
<div th:replace="~{fragments/layout :: alerts}"></div>

<main>
    <div class="container page">
        <div class="page-head">
            <div>
                <h1>Каталог комплектующих</h1>
                <p>Выберите детали и добавьте их в корзину или в свою сборку.</p>
            </div>
        </div>

        <!-- Блок с товарами -->
        <div class="grid" style="margin-top:24px;" th:if="${products != null and !#lists.isEmpty(products)}">
            <div class="product-card" th:each="p : ${products}">
                <div class="product-media">
                    <!-- Если есть картинка, выводим, иначе - бренд -->
                    <img th:if="${p.imageUrl != null}" th:src="${p.imageUrl}" alt="">
                    <div class="brand" th:if="${p.imageUrl == null}" th:text="${p.manufacturer}">Бренд</div>
                </div>
                <div class="product-body">
                    <h4 th:text="${p.name}">Название</h4>
                    <dl class="specs">
                        <div th:if="${p.category}"><dt>Категория</dt><dd th:text="${p.category.name}"></dd></div>
                        <div th:if="${p.socket}"><dt>Сокет</dt><dd th:text="${p.socket}"></dd></div>
                        <div th:if="${p.ramType}"><dt>Память</dt><dd th:text="${p.ramType}"></dd></div>
                    </dl>
                    <div class="product-buy">
                        <div class="price" th:text="${p.price} + ' ₽'">0 ₽</div>
                        <form th:action="@{/cart/add}" method="post">
                            <input type="hidden" name="componentId" th:value="${p.id}">
                            <button type="submit" class="buy-btn">В корзину</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="empty" th:if="${products == null or #lists.isEmpty(products)}">
            <p>Товары пока не добавлены.</p>
        </div>
    </div>
</main>

<footer class="site-footer">© 2026 Colizant</footer>
</body>
</html>


