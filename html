<!DOCTYPE html>
<html lang="ru" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Категории: Colizant</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@500;600;700&family=Onest:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<div th:replace="~{fragments/layout :: header('admin')}"></div>
<div th:replace="~{fragments/layout :: alerts}"></div>

<main>
    <div class="container page">
        <div class="page-head">
            <div>
                <h1>Категории</h1>
                <p>Разделы каталога комплектующих.</p>
            </div>
        </div>

        <div class="toolbar">
            <form th:action="@{/admin/categories/create}" method="post">
                <input class="input" type="text" name="name" placeholder="Название новой категории" required>
                <button type="submit" class="btn btn-primary">Добавить</button>
            </form>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                <tr><th>ID</th><th>Название</th><th class="end">Действия</th></tr>
                </thead>
                <tbody>
                <tr th:each="c : ${categories}">
                    <td th:text="${c.id}"></td>
                    <td>
                        <form th:action="@{/admin/categories/update}" method="post" class="inline-form">
                            <input type="hidden" name="id" th:value="${c.id}">
                            <input class="input" type="text" name="name" th:value="${c.name}" required style="padding: 6px 10px; width: 250px;">
                            <button type="submit" class="btn btn-sm btn-ink">💾</button>
                        </form>
                    </td>
                    <td class="end">
                        <form th:action="@{'/admin/categories/delete/' + ${c.id}}" method="post" class="actions" onsubmit="return confirm('Удалить категорию?');">
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</main>

<footer class="site-footer">© 2026 Colizant</footer>
</body>
</html>


<!DOCTYPE html>
<html lang="ru" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Комплектующие: Colizant</title>
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@500;600;700&family=Onest:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>

<div th:replace="~{fragments/layout :: header('admin')}"></div>
<div th:replace="~{fragments/layout :: alerts}"></div>

<main>
    <div class="container page">
        <div class="page-head">
            <div>
                <h1>Комплектующие</h1>
                <p>Каталог товаров: найдите, добавьте, измените или удалите позицию.</p>
            </div>
        </div>

        <div class="toolbar">
            <form action="/admin/components" method="get">
                <input class="input" type="search" name="search" placeholder="Поиск по названию" th:value="${search}">
                <button type="submit" class="btn btn-ink">Найти</button>
            </form>
            <button type="button" class="btn btn-primary" id="addBtn">Добавить комплектующее</button>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                <tr><th>Название</th><th>Бренд</th><th class="num">Цена</th><th class="num">Остаток</th><th class="end">Действия</th></tr>
                </thead>
                <tbody>
                <tr th:each="c : ${components}">
                    <td th:text="${c['name']}"></td>
                    <td th:text="${c['manufacturer']}"></td>
                    <td class="num" th:text="${c['price']} + ' ₽'"></td>
                    <td class="num" th:text="${c['stockQuantity']}"></td>
                    <td class="end">
                        <div class="actions">
                            <button type="button" class="btn btn-sm btn-outline js-edit"
                                    th:attr="data-id=${c['id']},data-name=${c['name']},data-brand=${c['manufacturer']},data-price=${c['price']},data-stock=${c['stockQuantity']}">
                                Изменить
                            </button>
                            <form th:action="@{'/admin/components/delete/' + ${c['id']}}" method="post" onsubmit="return confirm('Удалить?');">
                                <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                            </form>
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>

        <!-- Пагинация -->
        <nav class="pagination" th:if="${totalPages > 1}">
            <a th:if="${currentPage > 0}" th:href="@{/admin/components(page=${currentPage - 1}, search=${search})}">Назад</a>
            <span th:each="i : ${#numbers.sequence(0, totalPages - 1)}">
                <span th:if="${i == currentPage}" class="current" th:text="${i + 1}"></span>
                <a th:if="${i != currentPage}" th:href="@{/admin/components(page=${i}, search=${search})}" th:text="${i + 1}"></a>
            </span>
            <a th:if="${currentPage < totalPages - 1}" th:href="@{/admin/components(page=${currentPage + 1}, search=${search})}">Далее</a>
        </nav>

        <!-- Диалог редактирования -->
        <dialog id="editDialog">
            <h2>Редактирование</h2>
            <form id="editForm" method="post" th:action="@{/admin/components/update}">
                <input type="hidden" name="id" id="edit-id">
                <div class="form-group">
                    <label>Название</label>
                    <input class="input" type="text" id="edit-name" name="name" required>
                </div>
                <div class="form-group">
                    <label>Бренд</label>
                    <input class="input" type="text" id="edit-brand" name="manufacturer" required>
                </div>
                <div class="form-group">
                    <label>Цена, ₽</label>
                    <input class="input" type="number" id="edit-price" name="price" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Остаток</label>
                    <input class="input" type="number" id="edit-stock" name="stockQuantity" required>
                </div>
                <div class="dialog-actions">
                    <button type="button" class="btn btn-outline js-close">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </dialog>
    </div>
</main>

<script>
    var editDialog = document.getElementById('editDialog');
    document.querySelectorAll('.js-edit').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var d = btn.dataset;
            document.getElementById('edit-id').value = d.id;
            document.getElementById('edit-name').value = d.name;
            document.getElementById('edit-brand').value = d.brand;
            document.getElementById('edit-price').value = d.price;
            document.getElementById('edit-stock').value = d.stock;
            editDialog.showModal();
        });
    });
    document.querySelectorAll('.js-close').forEach(function (btn) {
        btn.addEventListener('click', function () { btn.closest('dialog').close(); });
    });
</script>
<footer class="site-footer">© 2026 Colizant</footer>
</body>
</html>


